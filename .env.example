# Copy to .env  (./setup.sh start does this for you the first time)

# Infrastructure — host ports from docker-compose.yml
DATABASE_URL=postgresql+asyncpg://reviewer:reviewer@localhost:5435/reviewer
REDIS_URL=redis://localhost:6380/0

# GitHub App (Phase 2) — see docs/SETUP-GITHUB-APP.md
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# OpenAI (Phase 3)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Guard-rails
MAX_DIFF_LINES=3000
MAX_INLINE_COMMENTS=25
DAILY_TOKEN_BUDGET=2000000

# Langfuse (Phase 6) — leave blank to disable tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
